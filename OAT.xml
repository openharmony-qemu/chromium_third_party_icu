                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*dat"
                    desc="" />
                <filteritem type="filepath" name=".*nrm"
                    desc="" />
                <filteritem type="filepath" name=".*res"
                    desc="" />
                <filteritem type="filepath" name=".*bin"
                    desc="" />
                <filteritem type="filepath" name=".*icu"
                    desc="" />

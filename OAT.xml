<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="Unicode-TOU" path=".*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="source.*" desc="" />
                <policyitem type="compatibility" name="NTP" path="source.*" desc="" /> 
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="source/common/emojiprops.h"
                    desc="" />
